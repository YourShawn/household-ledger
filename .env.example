# MySQL — localhost / private only. Never a public server IP.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=household_ledger
MYSQL_USER=ledger
MYSQL_PASSWORD=change-me-db
# Used only by `docker compose --profile bundled-mysql`
MYSQL_ROOT_PASSWORD=change-me-root

# Backend
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRATION_HOURS=12
LEDGER_SEED=true
LEDGER_CORS_ORIGINS=http://localhost:5173,http://localhost:8088
LEDGER_PUBLIC_BASE_URL=http://localhost:8088

# Optional SMTP for tier-3 auto-send emails. If unset, notices are logged only.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@localhost
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Frontend (Vite build / nginx)
VITE_API_BASE=
FRONTEND_PORT=8088
